# Optional Netlify site env (Site settings → Environment variables).
# Do not commit real keys. Do not rotate the SPA anon key without Joe.

SUPABASE_URL=https://ldgbghjjzbhtrgdnmlmv.supabase.co
SUPABASE_ANON_KEY=
# Required for the customer portal. Service role stays on Netlify, never in the SPA.
SUPABASE_SERVICE_ROLE_KEY=

# Starting password for a new customer login. Defaults to Dockafi1234.
# PORTAL_DEFAULT_PASSWORD=Dockafi1234

# Optional origin for login and reset links. Defaults to the request host, then production.
# PORTAL_SITE_URL=https://dockafiplatform.netlify.app

# Optional. The daily function also accepts this header for a manual run.
# CRON_SECRET=

# Operator who receives Tello-change drafts. Defaults to joeamilam@gmail.com.
# ADMIN_NOTIFY_EMAIL=joeamilam@gmail.com

# Leave unset. Drafts stay in Email drafts until an operator sends them.
# Set to true only if Resend or SMTP below is also configured.
# PORTAL_SEND_EMAIL=true
# RESEND_API_KEY=
# RESEND_FROM=DockaFi <support@dockafi.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=DockaFi <support@dockafi.com>
# SMTP_SECURE=false

# Optional: enables Claude answers in /api/help-assistant. Without it the
# function answers from the operations guide locally.
# ANTHROPIC_API_KEY=
