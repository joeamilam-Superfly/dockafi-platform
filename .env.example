# Optional Netlify site env (Site settings → Environment variables).
# Do not commit real keys. Do not rotate the SPA anon key without Joe.

SUPABASE_URL=https://ldgbghjjzbhtrgdnmlmv.supabase.co
SUPABASE_ANON_KEY=
# Required for the customer portal. Service role stays on Netlify, never in the SPA.
SUPABASE_SERVICE_ROLE_KEY=

# Portal and coverage email. Use one provider.
# Resend: verify a sender, then set both. The sandbox sender
# DockaFi <onboarding@resend.dev> only delivers to the Resend account email.
# RESEND_API_KEY=
# RESEND_FROM=DockaFi <portal@dockafi.com>
#
# Or SMTP:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=DockaFi <portal@dockafi.com>
# SMTP_SECURE=false

# Operator notified to change the Tello SIM. Defaults to joeamilam@gmail.com.
# ADMIN_NOTIFY_EMAIL=joeamilam@gmail.com

# Optional. The daily function also accepts this header for a manual run.
# CRON_SECRET=

# Optional origin for password links. Defaults to the request host, then production.
# PORTAL_SITE_URL=https://dockafiplatform.netlify.app

# Optional: enables Claude answers in /api/help-assistant. Without it the
# function answers from the operations guide locally.
# ANTHROPIC_API_KEY=
